# MongoDB — use MONGO_URI (Atlas) or DATABASE_URL (Railway/Heroku alias)
MONGO_URI=
# DATABASE_URL=

PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Game Telegram bot — GAME_BOT_TOKEN (Railway) or BOT_TOKEN
GAME_BOT_TOKEN=
BOT_TOKEN=

# Withdraw notification bot (separate @BotFather bot)
WITHDRAW_BOT_TOKEN=

# Admin withdraw notify chat IDs (comma-separated Telegram chat/user IDs)
ADMIN_CHAT_ID=
WITHDRAW_ADMIN_CHAT_ID=

# Telegram Mini App URL — public HTTPS URL of the deployed frontend
# Local: ngrok to Vite :5174. Railway: leave empty to use RAILWAY_PUBLIC_DOMAIN,
# or set to the Railway HTTPS URL. Do not keep an onrender/ngrok URL on Railway.
MINI_APP_URL=http://localhost:5174

# Admin panel
ADMIN_TOKEN=
ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_TELEGRAM_ID=

# Optional: set to true to run API only (no Telegram bots)
# DISABLE_TELEGRAM_BOTS=false

# Optional: internal API URL when withdraw bot runs as separate process
# API_INTERNAL_URL=http://127.0.0.1:3001

# qbirr payment verification (backend only — never put QBIRR_API_KEY in the Mini App)
# Railway does not upload this file — set the same variables in Railway Variables.
QBIRR_API_KEY=
QBIRR_BASE_URL=https://verify.qbirr.com
DEPOSIT_TELEBIRR_ACCOUNTS=
DEPOSIT_CBEBIRR_NUMBER=
DEPOSIT_CBEBIRR_RECEIVER_NAME=
DEPOSIT_CBEBIRR_ACCOUNT=
# Aliases also accepted: DEPOSIT_CBE_NUMBER, DEPOSIT_CBE_RECEIVER_NAME, DEPOSIT_CBE_ACCOUNT
# Or combined: DEPOSIT_CBEBIRR_ACCOUNTS=phone:receiverName
