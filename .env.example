# EDIL BINGO monorepo — copy to .env for local dev. Never commit .env files.
# Railway: set all values in the service Variables tab.

# --- Required ---
DATABASE_URL=
GAME_BOT_TOKEN=
WITHDRAW_BOT_TOKEN=
ADMIN_CHAT_ID=

# Aliases also supported: BOT_TOKEN, MONGO_URI, MONGODB_URI

# --- Server ---
PORT=3001
NODE_ENV=production

# --- Telegram Mini App ---
MINI_APP_URL=

# --- Admin panel / API auth ---
ADMIN_TOKEN=
ADMIN_PASSWORD=

# --- CORS (comma-separated; include your Railway public URL in production) ---
CORS_ORIGIN=

# --- qbirr payment verification (backend only — never expose QBIRR_API_KEY) ---
QBIRR_API_KEY=
QBIRR_BASE_URL=https://verify.qbirr.com
# phone:receiverName pairs. Example: 0979596741:WASIHUN,0926202638:tamirat,0970779529:WASIHUN
DEPOSIT_TELEBIRR_ACCOUNTS=
DEPOSIT_CBEBIRR_NUMBER=
DEPOSIT_CBEBIRR_RECEIVER_NAME=
DEPOSIT_CBEBIRR_ACCOUNT=

# --- Monorepo orchestrator ---
SERVE_MONOREPO_STATIC=true
DISABLE_TELEGRAM_BOTS=false
SKIP_MONOREPO_BUILD=false
BUILD_MONOREPO=false
# Root npm install uses workspaces; run `npm run build` after install (Railway does this automatically).

# --- Optional MongoDB tuning ---
MONGO_URI_DIRECT=
MONGO_CONNECT_RETRIES=5
