{
  "name": "edil-bingo",
  "version": "1.0.0",
  "description": "EDIL BINGO - 75-ball real-time Bingo Telegram Mini App",
  "private": true,
  "main": "server.js",
  "workspaces": [
    "backend",
    "frontend",
    "admin-panel",
    "verifier-api"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node scripts/build-monorepo.js",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin-panel",
    "build:verifier": "npm run build --prefix verifier-api",
    "backend": "npm run start --prefix backend",
    "bot": "node backend/src/bot.js",
    "withdraw-bot": "node withdrawBot.js",
    "admin": "npm run dev --prefix admin-panel",
    "frontend": "npm run dev --prefix frontend",
    "dev:stack": "concurrently -n api,front,admin \"npm run dev\" \"npm run dev --prefix frontend\" \"npm run dev --prefix admin-panel\""
  },
  "keywords": [
    "bingo",
    "telegram",
    "mini-app"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10"
  }
}
